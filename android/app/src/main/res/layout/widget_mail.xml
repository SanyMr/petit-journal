<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/w_root" android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@drawable/widget_bg">
    <ImageView android:id="@+id/w_art_br" android:layout_width="150dp" android:layout_height="96dp" android:layout_gravity="bottom|end"
        android:importantForAccessibility="no" android:scaleType="fitXY" android:src="@drawable/w_art_aki_br" />
    <ImageView android:id="@+id/w_art_tr" android:layout_width="96dp" android:layout_height="64dp" android:layout_gravity="top|end"
        android:importantForAccessibility="no" android:scaleType="fitXY" android:src="@drawable/w_art_aki_tr" />
<LinearLayout android:layout_width="match_parent" android:layout_height="match_parent"
    android:gravity="center_vertical" android:orientation="vertical" android:padding="14dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
        <FrameLayout android:layout_width="60dp" android:layout_height="52dp">
            <ImageView android:id="@+id/w_env" android:layout_width="54dp" android:layout_height="46dp" android:layout_gravity="bottom|start" android:contentDescription="@string/widget_mail_env" android:src="@drawable/w_env_letter" />
            <TextView android:id="@+id/w_badge" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="top|end"
                android:background="@drawable/widget_pill" android:minWidth="20dp" android:gravity="center" android:paddingStart="6dp" android:paddingEnd="6dp"
                android:text="1" android:textColor="@color/w_on_accent" android:textSize="11sp" android:textStyle="bold" />
        </FrameLayout>
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="10dp" android:layout_weight="1" android:orientation="vertical">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Boîte aux lettres · おてがみ" android:textColor="@color/w_muted" android:textSize="11sp" android:textStyle="bold" />
            <TextView android:id="@+id/w_title" android:layout_width="match_parent" android:layout_height="wrap_content" android:ellipsize="end" android:maxLines="1" android:text="Pas de lettre pour l'instant" android:textColor="@color/w_text" android:textSize="16sp" android:textStyle="bold" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:gravity="center_vertical" android:orientation="horizontal">
                <ImageView android:id="@+id/w_from_m" android:layout_width="18dp" android:layout_height="18dp" android:layout_marginEnd="4dp" android:importantForAccessibility="no" android:src="@drawable/w_onigiri" />
                <TextView android:id="@+id/w_from" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:ellipsize="end" android:maxLines="1" android:text="" android:textColor="@color/w_accent" android:textSize="13sp" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
    <TextView android:id="@+id/w_band_lbl" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:ellipsize="end" android:maxLines="1" android:text="Ma bande" android:textColor="@color/w_muted" android:textSize="11sp" android:textStyle="bold" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:orientation="horizontal">
        <FrameLayout android:id="@+id/w_c0" android:layout_width="38dp" android:layout_height="36dp" android:layout_marginEnd="4dp">
            <ImageView android:id="@+id/w_b0" android:layout_width="32dp" android:layout_height="32dp" android:importantForAccessibility="no" android:src="@drawable/w_onigiri" />
            <ImageView android:id="@+id/w_bf0" android:layout_width="15dp" android:layout_height="15dp" android:layout_gravity="bottom|end" android:importantForAccessibility="no" android:src="@drawable/w_flame_on" />
        </FrameLayout>
        <FrameLayout android:id="@+id/w_c1" android:layout_width="38dp" android:layout_height="36dp" android:layout_marginEnd="4dp">
            <ImageView android:id="@+id/w_b1" android:layout_width="32dp" android:layout_height="32dp" android:importantForAccessibility="no" android:src="@drawable/w_onigiri" />
            <ImageView android:id="@+id/w_bf1" android:layout_width="15dp" android:layout_height="15dp" android:layout_gravity="bottom|end" android:importantForAccessibility="no" android:src="@drawable/w_flame_on" />
        </FrameLayout>
        <FrameLayout android:id="@+id/w_c2" android:layout_width="38dp" android:layout_height="36dp" android:layout_marginEnd="4dp">
            <ImageView android:id="@+id/w_b2" android:layout_width="32dp" android:layout_height="32dp" android:importantForAccessibility="no" android:src="@drawable/w_onigiri" />
            <ImageView android:id="@+id/w_bf2" android:layout_width="15dp" android:layout_height="15dp" android:layout_gravity="bottom|end" android:importantForAccessibility="no" android:src="@drawable/w_flame_on" />
        </FrameLayout>
        <FrameLayout android:id="@+id/w_c3" android:layout_width="38dp" android:layout_height="36dp" android:layout_marginEnd="4dp">
            <ImageView android:id="@+id/w_b3" android:layout_width="32dp" android:layout_height="32dp" android:importantForAccessibility="no" android:src="@drawable/w_onigiri" />
            <ImageView android:id="@+id/w_bf3" android:layout_width="15dp" android:layout_height="15dp" android:layout_gravity="bottom|end" android:importantForAccessibility="no" android:src="@drawable/w_flame_on" />
        </FrameLayout>
        <FrameLayout android:id="@+id/w_c4" android:layout_width="38dp" android:layout_height="36dp" android:layout_marginEnd="4dp">
            <ImageView android:id="@+id/w_b4" android:layout_width="32dp" android:layout_height="32dp" android:importantForAccessibility="no" android:src="@drawable/w_onigiri" />
            <ImageView android:id="@+id/w_bf4" android:layout_width="15dp" android:layout_height="15dp" android:layout_gravity="bottom|end" android:importantForAccessibility="no" android:src="@drawable/w_flame_on" />
        </FrameLayout>
    </LinearLayout>
</LinearLayout>
</FrameLayout>
