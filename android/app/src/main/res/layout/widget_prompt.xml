<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/w_root" android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@drawable/widget_bg">
    <ImageView android:id="@+id/w_art_br" android:layout_width="150dp" android:layout_height="96dp" android:layout_gravity="bottom|end"
        android:importantForAccessibility="no" android:scaleType="fitXY" android:src="@drawable/w_art_aki_br" />
    <ImageView android:id="@+id/w_art_tr" android:layout_width="96dp" android:layout_height="64dp" android:layout_gravity="top|end"
        android:importantForAccessibility="no" android:scaleType="fitXY" android:src="@drawable/w_art_aki_tr" />
<LinearLayout
     android:layout_width="match_parent" android:layout_height="match_parent"
     android:orientation="vertical" android:padding="16dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:text="Question du jour · きょうのしつもん" android:textColor="@color/w_muted" android:textSize="12sp" android:textStyle="bold" />
        <ImageView android:id="@+id/w_mascot" android:layout_width="30dp" android:layout_height="30dp" android:contentDescription="@string/widget_mascot" android:src="@drawable/w_onigiri" />
    </LinearLayout>
    <TextView android:id="@+id/w_prompt" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
        android:layout_marginTop="4dp" android:ellipsize="end" android:fontFamily="sans-serif-medium" android:gravity="center_vertical"
        android:lineSpacingExtra="2dp" android:maxLines="4" android:text="Qu'est-ce qui t'a fait sourire aujourd'hui ?"
        android:textColor="@color/w_text" android:textSize="17sp" />
    <TextView android:id="@+id/w_btn" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="6dp"
        android:background="@drawable/widget_pill" android:paddingStart="14dp" android:paddingTop="6dp" android:paddingEnd="14dp" android:paddingBottom="6dp"
        android:text="Écrire ✎" android:textColor="@color/w_on_accent" android:textSize="13sp" android:textStyle="bold" />
</LinearLayout>
</FrameLayout>
