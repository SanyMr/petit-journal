<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/w_root" android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@drawable/widget_bg">
    <ImageView android:id="@+id/w_art_br" android:layout_width="150dp" android:layout_height="96dp" android:layout_gravity="bottom|end"
        android:importantForAccessibility="no" android:scaleType="fitXY" android:src="@drawable/w_art_aki_br" />
    <ImageView android:id="@+id/w_art_tr" android:layout_width="96dp" android:layout_height="64dp" android:layout_gravity="top|end"
        android:importantForAccessibility="no" android:scaleType="fitXY" android:src="@drawable/w_art_aki_tr" />
<LinearLayout
     android:layout_width="match_parent" android:layout_height="match_parent"
     android:gravity="center" android:orientation="vertical" android:padding="14dp">
    <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
        <ImageView android:id="@+id/w_mascot" android:layout_width="26dp" android:layout_height="26dp" android:contentDescription="@string/widget_mascot" android:src="@drawable/w_onigiri" />
        <TextView android:id="@+id/w_greet" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="6dp" android:text="Bonjour ✿" android:textColor="@color/w_muted" android:textSize="13sp" />
    </LinearLayout>
    <TextClock android:id="@+id/w_time" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:fontFamily="sans-serif-light" android:format12Hour="h:mm" android:format24Hour="HH:mm"
        android:includeFontPadding="false" android:letterSpacing="0.02" android:textColor="@color/w_accent" android:textSize="52sp" />
    <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
        <TextClock android:id="@+id/w_date" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:format12Hour="EEEE d MMMM" android:format24Hour="EEEE d MMMM" android:textColor="@color/w_text" android:textSize="14sp" />
        <TextClock android:id="@+id/w_jp" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="6dp"
            android:format12Hour="M月d日" android:format24Hour="M月d日" android:textColor="@color/w_muted" android:textSize="12sp" />
    </LinearLayout>
    <TextView android:id="@+id/w_status" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="6dp"
        android:text="✎ Ta page du jour t'attend" android:textColor="@color/w_accent" android:textSize="12sp" />
</LinearLayout>
</FrameLayout>
