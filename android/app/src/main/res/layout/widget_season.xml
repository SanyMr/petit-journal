<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/w_root" android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@drawable/widget_bg">
    <ImageView android:id="@+id/w_art_br" android:layout_width="150dp" android:layout_height="96dp" android:layout_gravity="bottom|end"
        android:importantForAccessibility="no" android:scaleType="fitXY" android:src="@drawable/w_art_aki_br" />
    <ImageView android:id="@+id/w_art_tr" android:layout_width="96dp" android:layout_height="64dp" android:layout_gravity="top|end"
        android:importantForAccessibility="no" android:scaleType="fitXY" android:src="@drawable/w_art_aki_tr" />
<LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center_vertical" android:orientation="vertical" android:padding="14dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
        <TextView android:id="@+id/w_k" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Saison japonaise · 二十四節気" android:textColor="@color/w_muted" android:textSize="11sp" android:textStyle="bold" />
        <TextView android:id="@+id/w_moon" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="🌕" android:textSize="20sp" />
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="bottom" android:orientation="horizontal">
        <TextView android:id="@+id/w_jp" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="立冬" android:textColor="@color/w_text" android:textSize="30sp" />
        <TextView android:id="@+id/w_fr" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:layout_marginBottom="5dp" android:text="Début de l'hiver" android:textColor="@color/w_accent" android:textSize="14sp" android:textStyle="bold" />
    </LinearLayout>
    <TextView android:id="@+id/w_line" android:layout_width="match_parent" android:layout_height="wrap_content" android:ellipsize="end" android:maxLines="2" android:text="" android:textColor="@color/w_text" android:textSize="13sp" />
    <TextView android:id="@+id/w_next" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:ellipsize="end" android:maxLines="1" android:text="" android:textColor="@color/w_muted" android:textSize="11sp" />
</LinearLayout>
</FrameLayout>