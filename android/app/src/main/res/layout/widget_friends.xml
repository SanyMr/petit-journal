        <TextView android:id="@+id/w_s0" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="2dp" android:minWidth="22dp" android:text="" android:textColor="@color/w_text" android:textSize="13sp" android:textStyle="bold" />
